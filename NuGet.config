<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pins the restore sources for this repository. Without <clear />, a developer's machine-level
    feeds leak into the build, which makes restores non-reproducible and breaks central package
    management source mapping.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
