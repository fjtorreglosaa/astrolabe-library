# Copy to .env and fill in. .env is git-ignored and must never be committed.
# RULE 8: secrets never live in committed files.

# --- Database ---
POSTGRES_DB=astrolabe
POSTGRES_USER=astrolabe
# Required. Generate one, for example: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Host port mappings ---
API_PORT=5080
WEB_PORT=5173
DB_PORT=5432

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development

# --- Token signing ---
# Required. At least 32 characters. Generate one, for example: openssl rand -base64 48
JWT_SIGNING_KEY=

# --- Transactional email (Mailgun) ---
# Required. Obtain from the Mailgun dashboard. Never commit a real value.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# EU accounts use https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_ADDRESS=
MAILGUN_FROM_NAME="Astrolabe Books"
# A sandbox domain only delivers to recipients authorised in the Mailgun dashboard.
MAILGUN_IS_SANDBOX=true

# --- AI providers (PLAN-001 Stage 7) ---
# Not needed before Stage 7. Keys are stored per library, encrypted at rest; these are the
# bootstrap values used to seed a development library configuration.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
